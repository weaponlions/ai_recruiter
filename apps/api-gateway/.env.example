# API Gateway Environment Variables
PORT=3000

# RS256 Public Key path (PEM file) used to verify JWTs issued by identity-service
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Downstream service URLs
IDENTITY_SERVICE_URL=http://localhost:3001
JOB_SERVICE_URL=http://localhost:3002
CANDIDATE_SERVICE_URL=http://localhost:3003
PIPELINE_SERVICE_URL=http://localhost:3004
DOCUMENT_SERVICE_URL=http://localhost:3005
AI_SERVICE_URL=http://localhost:3006
COMMUNICATION_SERVICE_URL=http://localhost:3007
AUDIT_SERVICE_URL=http://localhost:3008

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
