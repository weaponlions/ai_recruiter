# Identity Service Environment Variables
PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/identity_db?schema=public

# RS256 private key — inline PEM (use \n for line breaks) or file path
# Generate with: openssl genrsa -out private.pem 2048
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n<YOUR_KEY_HERE>\n-----END RSA PRIVATE KEY-----"

# RS256 public key for distributing to other services
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<YOUR_KEY_HERE>\n-----END PUBLIC KEY-----"

# Token expiry durations
JWT_EXPIRY=15m
REFRESH_EXPIRY=7d

# Redis for BullMQ event bus
REDIS_URL=redis://localhost:6379

# MFA issuer name shown in authenticator apps
MFA_ISSUER=HR-AI-Platform
