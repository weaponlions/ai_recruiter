# document-service environment variables
PORT=3005

# PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/document_db

# Redis (used by BullMQ EventBus)
REDIS_URL=redis://localhost:6379

# S3 / MinIO storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hr-ai-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Upload constraints
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,application/msword
