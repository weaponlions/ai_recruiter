// This file is a shared Prisma service used across service modules
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Job ────────────────────────────────────────────────────────────────────
model Job {
  id          String    @id @default(uuid())
  tenantId    String
  title       String
  description String
  requirements String?
  location    String?
  type        String    @default("FULL_TIME")
  status      String    @default("DRAFT")
  templateId  String?
  publishedAt DateTime?
  closedAt    DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications Application[]

  @@index([tenantId])
  @@index([tenantId, status])
}

// ─── Job Template ────────────────────────────────────────────────────────────
model JobTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  content   Json
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ─── Application ─────────────────────────────────────────────────────────────
model Application {
  id          String   @id @default(uuid())
  tenantId    String
  jobId       String
  candidateId String
  coverLetter String?
  appliedAt   DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])

  @@index([tenantId])
  @@index([jobId])
}
