# ─────────────────────────────────────────────────────────────────────────────
# Root / Shared (copy to .env at repo root if needed)
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# API Gateway
# ─────────────────────────────────────────────────────────────────────────────
GATEWAY_PORT=3000
GATEWAY_JWT_PUBLIC_KEY_PATH=./keys/jwt.public.pem

# ─────────────────────────────────────────────────────────────────────────────
# Identity Service
# ─────────────────────────────────────────────────────────────────────────────
IDENTITY_PORT=3001
IDENTITY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/identity_db
IDENTITY_JWT_PRIVATE_KEY_PATH=./keys/jwt.private.pem
IDENTITY_JWT_PUBLIC_KEY_PATH=./keys/jwt.public.pem
IDENTITY_JWT_EXPIRY=15m
IDENTITY_REFRESH_EXPIRY=7d

# ─────────────────────────────────────────────────────────────────────────────
# Job Service
# ─────────────────────────────────────────────────────────────────────────────
JOB_PORT=3002
JOB_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_db

# ─────────────────────────────────────────────────────────────────────────────
# Candidate Service
# ─────────────────────────────────────────────────────────────────────────────
CANDIDATE_PORT=3003
CANDIDATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/candidate_db

# ─────────────────────────────────────────────────────────────────────────────
# Pipeline Service
# ─────────────────────────────────────────────────────────────────────────────
PIPELINE_PORT=3004
PIPELINE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pipeline_db

# ─────────────────────────────────────────────────────────────────────────────
# Document Service
# ─────────────────────────────────────────────────────────────────────────────
DOCUMENT_PORT=3005
DOCUMENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/document_db
DOCUMENT_S3_ENDPOINT=http://localhost:9000
DOCUMENT_S3_BUCKET=hr-ai-documents
DOCUMENT_S3_REGION=us-east-1
DOCUMENT_S3_ACCESS_KEY=minioadmin
DOCUMENT_S3_SECRET_KEY=minioadmin

# ─────────────────────────────────────────────────────────────────────────────
# AI Service
# ─────────────────────────────────────────────────────────────────────────────
AI_PORT=3006
AI_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_db
AI_REDIS_URL=redis://localhost:6379
AI_OPENAI_API_KEY=sk-your-key-here
AI_ANTHROPIC_API_KEY=your-key-here
AI_DEFAULT_MODEL=gpt-4o-mini
AI_FALLBACK_MODEL=gpt-3.5-turbo

# ─────────────────────────────────────────────────────────────────────────────
# Communication Service
# ─────────────────────────────────────────────────────────────────────────────
COMMUNICATION_PORT=3007
COMMUNICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/communication_db
COMMUNICATION_SMTP_HOST=localhost
COMMUNICATION_SMTP_PORT=1025
COMMUNICATION_RESEND_API_KEY=re_your-key-here
COMMUNICATION_FROM_EMAIL=noreply@hr-ai.local

# ─────────────────────────────────────────────────────────────────────────────
# Audit Service
# ─────────────────────────────────────────────────────────────────────────────
AUDIT_PORT=3008
AUDIT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audit_db

# ─────────────────────────────────────────────────────────────────────────────
# Shared / Infrastructure
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
